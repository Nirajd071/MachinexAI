# SMTP Configuration for Emergency Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Emergency Alert Recipients
ADMIN_EMAIL=technician@example.com
ADMIN_PHONE_EMAIL=
# Without complete SMTP credentials, dispatch is disabled. Set true only to
# explicitly use Nodemailer/Ethereal preview delivery.
SMTP_TEST_MODE=false

# Comma-separated browser origins allowed to call the Python API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
